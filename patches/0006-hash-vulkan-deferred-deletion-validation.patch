+#if (UE_BUILD_DEBUG || UE_BUILD_DEVELOPMENT)
+	namespace
+	{
+		struct FDeferredDeletionKey
+		{
+			FDeferredDeletionQueue2::EType Type;
+			uint64 Handle;
+
+			bool operator==(const FDeferredDeletionKey& Other) const
+			{
+				return Type == Other.Type && Handle == Other.Handle;
+			}
+
+			friend uint32 GetTypeHash(const FDeferredDeletionKey& Key)
+			{
+				return HashCombineFast(::GetTypeHash(static_cast<uint32>(Key.Type)), ::GetTypeHash(Key.Handle));
+			}
+		};
+
+		// Keep private device/queue layouts compatible with precompiled consumers. The
+		// queue's CS is always acquired before this lock; never hold it during deletion
+		// callbacks. Separate keys per queue also cover multiple Vulkan devices.
+		FCriticalSection GDeferredDeletionIndexCS;
+		TMap<const FDeferredDeletionQueue2*, TMap<FDeferredDeletionKey, uint32>> GDeferredDeletionIndices;
+
+		bool AddDeferredDeletionKey(const FDeferredDeletionQueue2* Queue, FDeferredDeletionQueue2::EType Type, uint64 Handle)
+		{
+			FScopeLock Lock(&GDeferredDeletionIndexCS);
+			uint32& Count = GDeferredDeletionIndices.FindChecked(Queue).FindOrAdd({ Type, Handle });
+			return Count++ != 0;
+		}
+
+		void RemoveDeferredDeletionKey(const FDeferredDeletionQueue2* Queue, FDeferredDeletionQueue2::EType Type, uint64 Handle)
+		{
+			FScopeLock Lock(&GDeferredDeletionIndexCS);
+			auto& Index = GDeferredDeletionIndices.FindChecked(Queue);
+			const FDeferredDeletionKey Key{ Type, Handle };
+			uint32& Count = Index.FindChecked(Key);
+			if (--Count == 0)
+			{
+				Index.Remove(Key);
+			}
+		}
+
+		void ResetDeferredDeletionIndex(const FDeferredDeletionQueue2* Queue)
+		{
+			FScopeLock Lock(&GDeferredDeletionIndexCS);
+			GDeferredDeletionIndices.FindChecked(Queue).Reset();
+		}
+
+		TAutoConsoleVariable<int32> CVarDeferredDeletionLinearValidation(
+			TEXT("r.Vulkan.DeferredDeletionQueue.LinearValidation"), 0,
+			TEXT("Also run the original linear duplicate check, verifying the hash index. Development profiling only."));
+	}
+#endif
