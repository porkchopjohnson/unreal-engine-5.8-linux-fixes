 	FDeferredDeletionQueue2::FDeferredDeletionQueue2(FVulkanDevice& InDevice)
 		: Device(InDevice)
 	{
+#if (UE_BUILD_DEBUG || UE_BUILD_DEVELOPMENT)
+		FScopeLock Lock(&GDeferredDeletionIndexCS);
+		check(!GDeferredDeletionIndices.Contains(this));
+		GDeferredDeletionIndices.Add(this);
+		static FAutoConsoleCommand BenchmarkCommand(
+			TEXT("Vulkan.DeletionQueue.Benchmark"),
+			TEXT("Benchmark duplicate validation on synthetic entries; creates/deletes no Vulkan resources."),
+			FConsoleCommandDelegate::CreateLambda([]()
+			{
+				TArray<FEntry> TestEntries;
+				// Opaque registry identity only, never dereferenced as a queue.
+				const auto* TestQueue = reinterpret_cast<const FDeferredDeletionQueue2*>(&TestEntries);
+				{
+					FScopeLock IndexLock(&GDeferredDeletionIndexCS);
+					GDeferredDeletionIndices.Add(TestQueue);
+				}
+				check(!AddDeferredDeletionKey(TestQueue, EType::Buffer, 7));
+				check(!AddDeferredDeletionKey(TestQueue, EType::Image, 7));
+				check(AddDeferredDeletionKey(TestQueue, EType::Buffer, 7));
+				RemoveDeferredDeletionKey(TestQueue, EType::Buffer, 7);
+				RemoveDeferredDeletionKey(TestQueue, EType::Buffer, 7);
+				check(!AddDeferredDeletionKey(TestQueue, EType::Buffer, 7));
+				check(!AddDeferredDeletionKey(TestQueue, EType::Func, 0));
+				check(AddDeferredDeletionKey(TestQueue, EType::Func, 0));
+				RemoveDeferredDeletionKey(TestQueue, EType::Func, 0);
+				check(AddDeferredDeletionKey(TestQueue, EType::Func, 0));
+				ResetDeferredDeletionIndex(TestQueue);
+				check(!AddDeferredDeletionKey(TestQueue, EType::Func, 0));
+				ResetDeferredDeletionIndex(TestQueue);
+
+				FCriticalSection TestCS;
+				for (int32 QueueSize : { 10016, 21692 })
+				{
+					for (int32 Trial = 0; Trial < 5; ++Trial)
+					{
+						for (bool bHash : { false, true })
+						{
+							TestEntries.Reset();
+							TestEntries.Reserve(QueueSize + 1);
+							ResetDeferredDeletionIndex(TestQueue);
+							for (int32 Index = 0; Index < QueueSize; ++Index)
+							{
+								FEntry Entry;
+								Entry.StructureType = EType::BufferView;
+								Entry.Handle = Index + 1;
+								TestEntries.Add(Entry);
+								if (bHash) { AddDeferredDeletionKey(TestQueue, Entry.StructureType, Entry.Handle); }
+							}
+							const double Start = FPlatformTime::Seconds();
+							constexpr int32 Iterations = 10000;
+							for (int32 Index = 0; Index < Iterations; ++Index)
+							{
+								FScopeLock QueueLock(&TestCS);
+								FEntry Entry;
+								Entry.StructureType = EType::BufferView;
+								Entry.Handle = uint64(QueueSize) + Index + 1;
+								const bool bDuplicate = bHash ? AddDeferredDeletionKey(TestQueue, Entry.StructureType, Entry.Handle) :
+									TestEntries.ContainsByPredicate([&](const FEntry& Other)
+									{
+										return Other.Handle == Entry.Handle && Other.StructureType == Entry.StructureType;
+									});
+								check(!bDuplicate);
+								TestEntries.Add(Entry);
+								const FEntry& Old = TestEntries[0];
+								if (bHash) { RemoveDeferredDeletionKey(TestQueue, Old.StructureType, Old.Handle); }
+								TestEntries.RemoveAtSwap(0, EAllowShrinking::No);
+							}
+							UE_LOG(LogVulkanRHI, Display, TEXT("DeletionLookupBenchmark entries=%d entry_bytes=%d trial=%d mode=%s operations=%d elapsed_ms=%.3f"),
+								QueueSize, int32(sizeof(FEntry)), Trial, bHash ? TEXT("hash") : TEXT("linear"), Iterations, (FPlatformTime::Seconds() - Start) * 1000.0);
+						}
+						// Reverse traversal and whole-array transfer mirror both deferred drains.
+						for (int32 Index = TestEntries.Num() - 1; Index >= 0; --Index)
+						{
+							RemoveDeferredDeletionKey(TestQueue, TestEntries[Index].StructureType, TestEntries[Index].Handle);
+							TestEntries.RemoveAtSwap(Index, EAllowShrinking::No);
+						}
+					}
+				}
+				{
+					FScopeLock IndexLock(&GDeferredDeletionIndexCS);
+					check(GDeferredDeletionIndices.FindChecked(TestQueue).Num() == 0);
+					GDeferredDeletionIndices.Remove(TestQueue);
+				}
+				UE_LOG(LogVulkanRHI, Display, TEXT("DeletionLookupBenchmark safety checks passed"));
+			}));
+#endif
 	}
 
 	FDeferredDeletionQueue2::~FDeferredDeletionQueue2()
