 // The threshold is selected to address a hardware related difference
 float UContourDataComparisonHelper::ContourComparisonTolerance = 2.4f;
 
+#if WITH_DEV_AUTOMATION_TESTS
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FMetaHumanPelvisDetailsTest, "MetaHuman.Performance.PelvisSettingsDetails",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+bool FMetaHumanPelvisDetailsTest::RunTest(const FString&)
+{
+	TStrongObjectPtr<UMetaHumanPerformance> Performance(NewObject<UMetaHumanPerformance>());
+	Performance->InputType = EDataInputType::MonoFootage;
+	Performance->bBodyTracking = true;
+	FPropertyEditorModule& PropertyEditor = FModuleManager::LoadModuleChecked<FPropertyEditorModule>("PropertyEditor");
+	FDetailsViewArgs Args;
+	Args.bUpdatesFromSelection = false;
+	const auto Details = PropertyEditor.CreateDetailView(Args);
+	Details->SetObject(Performance.Get());
+	auto CountProperty = [&](FName Name)
+	{
+		int32 Count = 0;
+		for (const FPropertyPath& Path : Details->GetPropertiesInOrderDisplayed())
+		{
+			if (Path.IsValid() && Path.GetLeafMostProperty().Property->GetFName() == Name) { ++Count; }
+		}
+		return Count;
+	};
+	const FName Names[] = {
+		GET_MEMBER_NAME_CHECKED(UMetaHumanPerformance, bEnablePelvisRefinement),
+		GET_MEMBER_NAME_CHECKED(UMetaHumanPerformance, PelvisPitchStrength),
+		GET_MEMBER_NAME_CHECKED(UMetaHumanPerformance, PelvisRollStrength),
+		GET_MEMBER_NAME_CHECKED(UMetaHumanPerformance, PelvisTwistStrength),
+		GET_MEMBER_NAME_CHECKED(UMetaHumanPerformance, PelvisEasingStrength),
+		GET_MEMBER_NAME_CHECKED(UMetaHumanPerformance, bPelvisImageTracking),
+		GET_MEMBER_NAME_CHECKED(UMetaHumanPerformance, PelvisExaggeration),
+		GET_MEMBER_NAME_CHECKED(UMetaHumanPerformance, bUsePelvisConsoleSettings)
+	};
+	for (FName Name : Names)
+	{
+		TestEqual(FString::Printf(TEXT("Body tracking details display %s exactly once"), *Name.ToString()), CountProperty(Name), 1);
+		const FProperty* Property = FindFProperty<FProperty>(UMetaHumanPerformance::StaticClass(), Name);
+		TestTrue(TEXT("Control is editable and saved, not transient"), Property && Property->HasAnyPropertyFlags(CPF_Edit) && !Property->HasAnyPropertyFlags(CPF_Transient));
+	}
+	Performance->InputType = EDataInputType::Audio;
+	Details->ForceRefresh();
+	for (FName Name : Names) { TestEqual(TEXT("Pelvis controls are absent from audio details"), CountProperty(Name), 0); }
+	return true;
+}
+#endif
