+		Options.Fit.EasingStrength = Performance->PelvisEasingStrength;
+		Options.Fit.SurfaceWeight = Performance->PelvisImageWeight;
+		Options.Fit.MaxTiltDegrees = Performance->PelvisMaxTilt;
+		Options.Fit.MaxTwistDegrees = Performance->PelvisMaxTwist;
+	}
+	else
+	{
+		Options.bUsingConsoleSettings = true;
