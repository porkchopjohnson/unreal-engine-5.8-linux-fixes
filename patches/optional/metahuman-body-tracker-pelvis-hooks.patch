+		Options.Fit.MaxTiltDegrees = CVarPelvisMaxTilt.GetValueOnAnyThread();
+		Options.Fit.MaxTwistDegrees = CVarPelvisMaxTwist.GetValueOnAnyThread();
+	}
+	return Options;
