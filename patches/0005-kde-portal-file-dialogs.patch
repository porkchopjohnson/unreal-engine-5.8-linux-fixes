+// Linux desktop-portal integration for the synchronous DesktopPlatform interface.
+#pragma once
+
+#include "CoreMinimal.h"
+
+namespace LinuxPortalFileDialog
+{
+	enum class EType : uint8 { Open, Save, Directory };
+	enum class EResult : uint8 { Unavailable, Cancelled, Accepted, Failed };
+
+	// Only Unavailable permits falling back to Slate. Cancellation and errors after
+	// opening a native dialog must not cause a second picker to appear.
+	EResult Show(EType Type, const void* ParentWindowHandle, const FString& Title,
+		const FString& DefaultPath, const FString& DefaultFile, const FString& FileTypes,
+		uint32 Flags, TArray<FString>& OutFilenames, int32& OutFilterIndex);
+}
